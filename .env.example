# ---------------------------------------------------------------------------
# RaccourcIA - variables d'environnement
# Copier en .env.local pour le developpement. NE JAMAIS COMMITER .env.local.
# ---------------------------------------------------------------------------

# --- Public (expose au navigateur : aucun secret ici) ---
NEXT_PUBLIC_SUPABASE_URL=https://jhqajkhovtcjklrjgwrx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Serveur uniquement (Vercel : Environment Variables, jamais NEXT_PUBLIC_) ---
# Cle service_role Supabase. Contourne la RLS : usage serveur strictement controle.
SUPABASE_SERVICE_ROLE_KEY=

# Pepper HMAC-SHA256 pour l'empreinte des licences Chariow.
# Generer avec : openssl rand -base64 48
LICENSE_PEPPER=

# --- Chariow (lot 7) ---
# Secret du Pulse : cote verification, voir lib/webhooks/chariow.ts (le nom
# exact de l'en-tete et l'algorithme utilises par Chariow restent a confirmer
# avant la mise en production, voir docs/SECURITY.md).
CHARIOW_WEBHOOK_SECRET=
CHARIOW_API_KEY=

# --- Administration du projet (scripts CLI uniquement, hors runtime) ---
SUPABASE_PROJECT_REF=jhqajkhovtcjklrjgwrx
SUPABASE_DB_PASSWORD=
